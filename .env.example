# Puerto HTTP (usado en Render y desarrollo local; ignorado en Vercel Serverless)
PORT=3005

# Entorno de ejecución: development | production | test
NODE_ENV=production

# Orígenes CORS adicionales separados por coma (vacío = permite same-origin y localhost en dev)
ALLOWED_ORIGINS=

# Presupuestos de tiempo (ms) alineados con límites Serverless
SCRAPE_TIMEOUT_MS=12000
DEEP_SCRAPE_BUDGET_MS=25000
PROXY_TIMEOUT_MS=20000

# Límites de seguridad y memoria
MAX_SCRAPE_HTML_BYTES=5242880
MAX_ZIP_ITEMS=25
MAX_ZIP_ITEM_BYTES=26214400
MAX_ZIP_TOTAL_BYTES=104857600

# Exportación directa al sistema de archivos del servidor (false por defecto en la nube; si se habilita en cloud se confina a /tmp/mediascraper)
ENABLE_LOCAL_FS_EXPORT=false

# Límites de peticiones por minuto por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_SCRAPE=20
RATE_LIMIT_MAX_PROXY=180
RATE_LIMIT_MAX_EXPORT=10
